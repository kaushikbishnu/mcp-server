# Copy this file to ".env" and fill in your Azure SQL details.
# ".env" is already git-ignored and must never be committed.

# Option A: a single full ODBC connection string (takes priority if set).
# AZURE_SQL_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=tcp:<server>.database.windows.net,1433;DATABASE=<database>;UID=<username>;PWD=<password>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Option B: discrete parts, assembled into a connection string automatically.
AZURE_SQL_SERVER=<your-server>.database.windows.net
AZURE_SQL_DATABASE=<your-database>
AZURE_SQL_USERNAME=<your-username>
AZURE_SQL_PASSWORD=<your-password>
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false

# Query safety
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=30

# HTTP server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
